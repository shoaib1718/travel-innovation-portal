@page
@model TravelInnovationPortal.Pages.Ideas.ListModel

@{
    ViewData["Title"] = "Ideas Dashboard";
}

<h2>Ideas Dashboard</h2>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Id</th>
            <th>Service Id</th>
            <th>Idea Title</th>
            <th>Description</th>
            <th>Created Date</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Ideas)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ServiceId</td>
                <td>@item.IdeaTitle</td>
                <td>@item.IdeaDescription</td>
                <td>@item.CreatedDate</td>
            </tr>
        }

    </tbody>

</table>